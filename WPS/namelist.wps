# =========================================================================
# WPS namelist — 河西走廊三层嵌套 9km / 3km / 1km
# 域中心: 38.0142°N, 100.3421°E (Hexi Corridor)
# ERA5 原始 grib: /wrfdata/metdata/0N80N_40E150E_{pl,sfc}_YYYYMMDD.grib (3h, 0.25°)
# 地理静态数据: /wrfdata/staticdata/wps_geog/
# ungrib 流程: PFILE(临时) -> rrpr -> FILE(最终) -> 删 PFILE
# metgrid fg_name 用最终 FILE (非 PFILE)
# =========================================================================

&share
 wrf_core         = 'ARW',
 max_dom          = 3,
 start_date       = '2021-07-01_00:00:00',
                    '2021-07-01_00:00:00',
                    '2021-07-01_00:00:00',
 end_date         = '2023-07-01_00:00:00',
                    '2023-07-01_00:00:00',
                    '2023-07-01_00:00:00',
 interval_seconds = 10800,
 io_form_geogrid  = 2,
 opt_output_from_geogrid_path =
   '/wrfrun/2021-2023_hexizoulang/wpsout/geogrid/',
/

&geogrid
 parent_id         = 1, 1, 2,
 parent_grid_ratio = 1, 3, 3,
 i_parent_start    = 1, 55, 55,
 j_parent_start    = 1, 55, 55,
 e_we              = 163, 163, 163,
 e_sn              = 163, 163, 163,
 geog_data_res     = 'srtm_3s', 'srtm_3s', 'srtm_3s',
 dx                = 9000,
 dy                = 9000,
 map_proj          = 'lambert',
 ref_lat           = 38.0142,
 ref_lon           = 100.3421,
 truelat1          = 30.0,
 truelat2          = 60.0,
 stand_lon         = 100.3421,
 geog_data_path    = '/wrfdata/staticdata/wps_geog/',
/

&ungrib
 out_format = 'WPS',
 prefix =
   '/wrfrun/2021-2023_hexizoulang/wpsout/ungrib/FILE',
/

&metgrid
 fg_name =
   '/wrfrun/2021-2023_hexizoulang/wpsout/ungrib/FILE',
 io_form_metgrid = 2,
 opt_output_from_metgrid_path =
   '/wrfrun/2021-2023_hexizoulang/wpsout/metgrid/',
 constants_name = 'TAVGSFC',
/
